// Career OPS — Student Master Profile (normalized relational schema)
// Production database: PostgreSQL (Neon), provisioned via Vercel.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")           // pooled connection for the app
  directUrl = env("DATABASE_URL_UNPOOLED")  // direct connection for migrations
}

// --- Account / authentication ---
// One User == one login. Each User owns exactly one Student master profile.
// Every per-user entity (profile, resume, tracked jobs, searches, views,
// recommendations) is keyed to User.id via the Student relation or userId.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student      Student?
  trackedJobs  TrackedJob[]
  searches     SearchHistory[]
  viewedJobs   ViewedJob[]
}

model Student {
  id String @id @default(cuid())

  // --- Owning account (1:1). Nullable for legacy/admin-seeded rows. ---
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- Unique human-facing student code (immutable, e.g. CO-2026-000001) ---
  // Generated once at creation from an atomic counter; never updated.
  studentId String? @unique

  // --- Personal information ---
  firstName     String
  middleName    String?
  lastName      String
  aadhaarNumber String?
  gender        String?
  nationality   String?
  dateOfBirth   String?

  // --- Address ---
  address1 String?
  address2 String?
  city     String?
  state    String?
  district String?
  pinCode  String?
  country  String?

  // --- Contact ---
  email    String  @unique
  phone    String?
  altPhone String?

  // --- Social ---
  linkedinUrl String?
  githubUrl   String?

  // --- Professional summary ---
  summary         String?
  description     String?
  yearsExperience Float?

  // --- Meta ---
  profileCompleteness Int      @default(0)

  // Denormalized JSON snapshot of the profile (skills/education/experience/
  // projects/certifications). Regenerated on every create/update; the
  // normalized child tables remain the source of truth.
  profileJson Json?

  // --- Resume metadata (the binary lives in StudentResumeFile) ---
  resumeFileName   String?
  resumeMimeType   String?
  resumeSource     String? // e.g. "gemini" | "mock" | "upload"
  resumeUploadedAt DateTime?

  // --- Profile picture metadata (the binary lives in StudentAvatarFile) ---
  avatarFileName   String?
  avatarMimeType   String?
  avatarUploadedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Relations (normalized child entities) ---
  education      Education[]
  experience     Experience[]
  projects       Project[]
  certifications Certification[]
  skills         Skill[]
  softSkills     SoftSkill[]
  achievements   Achievement[]
  awards         Award[]
  resumeFile     StudentResumeFile?
  avatarFile     StudentAvatarFile?
}

// One-to-one binary store for the uploaded resume. Kept separate so profile/
// list queries never load the blob; only the View/Download route reads it.
// Atomic, monotonic counters (e.g. the running student sequence). Incrementing
// inside a transaction guarantees collision-free sequential studentId codes.
model Counter {
  id    String @id
  value Int    @default(0)
}

model StudentResumeFile {
  id        String   @id @default(cuid())
  studentId String   @unique
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  data      Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One-to-one binary store for the profile picture. Same rationale as the
// resume blob: list/profile queries never load it, only the image route does.
model StudentAvatarFile {
  id        String   @id @default(cuid())
  studentId String   @unique
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  data      Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Education {
  id            String  @id @default(cuid())
  studentId     String
  student       Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  degree        String?
  fieldOfStudy  String?
  institution   String?
  location      String?
  dateOfPassing String?
  cgpa          String?
  percentage    String?
  achievements  String?

  @@index([studentId])
}

model Experience {
  id               String  @id @default(cuid())
  studentId        String
  student          Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  jobTitle         String?
  companyName      String?
  location         String?
  employmentType   String?
  startDate        String?
  endDate          String?
  responsibilities String?
  achievements     String?
  technologies     String?

  @@index([studentId])
}

model Project {
  id           String  @id @default(cuid())
  studentId    String
  student      Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title        String?
  description  String?
  technologies String?

  @@index([studentId])
}

model Certification {
  id          String  @id @default(cuid())
  studentId   String
  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String?
  number      String?
  description String?

  @@index([studentId])
}

// Technical skills. `category` is one of:
// language | framework | database | cloud | tool | other
model Skill {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  category  String
  name      String

  @@index([studentId])
}

model SoftSkill {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name      String

  @@index([studentId])
}

model Achievement {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  text      String

  @@index([studentId])
}

model Award {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  text      String

  @@index([studentId])
}

// ── Central Job database ─────────────────────────────────────────────
// One row per discovered posting. Filled by seed data (source="seed") and/or
// live ATS ingestion (source="greenhouse"|"lever"|"ashby"). Both paths write
// the SAME shape, so search + recommendations are source-agnostic.
model Job {
  id              String   @id @default(cuid())
  source          String   // "seed" | "greenhouse" | "lever" | "ashby" | ...
  externalId      String   // provider posting id (or a stable slug for seeds)
  title           String
  company         String
  location        String?
  atsUrl          String?  // direct apply / ATS posting URL
  careerPortalUrl String?  // company careers page
  description     String?
  category        String?  // derived bucket, e.g. "Software Engineering", "Data"
  postedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trackedBy TrackedJob[]
  viewedBy  ViewedJob[]

  @@unique([source, externalId])
  @@index([title])
  @@index([company])
  @@index([category])
}

// ── Per-user job tracker (Save Job → Applied → Interview → Rejected → Offer)
model TrackedJob {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String?  // nullable: manually-added roles need no Job row
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  company   String
  role      String
  location  String?
  status    String   @default("Saved") // Saved|Applied|Interview|Rejected|Offer
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@unique([userId, jobId])
}

// ── Recommendation signals ───────────────────────────────────────────
model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query     String
  kind      String   // "title" | "company"
  createdAt DateTime @default(now())

  @@index([userId])
}

model ViewedJob {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId    String
  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@unique([userId, jobId])
  @@index([userId])
}
