# ── Database ──────────────────────────────────────────────────────────
# PostgreSQL (Neon in production). Copy this file to `.env`, then run:
#   npx prisma db push   (or apply prisma/sql/001_student_portal.sql)
#   npm run db:seed
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ── Auth ──────────────────────────────────────────────────────────────
# HMAC secret for signing session cookies. MUST be set in production.
SESSION_SECRET="change-me-to-a-long-random-string"

# ── Resume extraction (swappable adapter — src/lib/resumeExtractor.ts) ──
# RESUME_EXTRACT_PROVIDER: auto | team-api | gemini | local   (default: auto)
# RESUME_EXTRACT_PROVIDER="auto"
#
# team-api: the API the team will provide later. When RESUME_EXTRACT_API_URL
# is set, the file is POSTed there and the JSON response (ParsedProfile shape,
# or { parsed: ParsedProfile }) is used. No other code changes needed.
# RESUME_EXTRACT_API_URL="https://your-resume-api.example.com/extract"
# RESUME_EXTRACT_API_KEY="optional-bearer-token"
#
# gemini fallback (used by "auto" when no team API key is present):
# GEMINI_API_KEY="your-google-ai-studio-key"
# GEMINI_MODEL="gemini-1.5-flash"
