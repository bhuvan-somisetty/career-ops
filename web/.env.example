# Local SQLite database for the Student Master Profile system.
# Copy this file to `.env`, then run: npm run db:migrate && npm run db:seed
DATABASE_URL="file:./dev.db"

# Optional — enables REAL resume extraction via Gemini.
# Without it, /api/resume/extract returns a deterministic offline sample.
# GEMINI_API_KEY="your-google-ai-studio-key"
# GEMINI_MODEL="gemini-1.5-flash"
